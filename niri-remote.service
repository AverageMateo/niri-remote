[Unit]
Description=Touch control panel for niri (Tailscale only)
After=graphical-session.target tailscaled.service

[Service]
EnvironmentFile=%h/.config/niri-remote/profile.env
ExecStart=/usr/bin/python3 %h/.local/share/niri-remote/panel.py ${PANEL_BIND}
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
