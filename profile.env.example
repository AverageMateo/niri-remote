# Copy to ~/.config/niri-remote/profile.env and set your bind address.
# Use your Tailscale IP (e.g. `tailscale ip -4`), LAN IP, or 127.0.0.1 when using `tailscale serve`.
PANEL_BIND=127.0.0.1

# Browser tab / PWA title and app name
PANEL_TITLE=niri
PANEL_NAME=niri remote

# Comma-separated optional features (default: scale; set empty to hide scale controls)
# PANEL_FEATURES=scale

# Idle timeout in seconds before PIN is requested again (default: 600)
# PANEL_PIN_TIMEOUT=600
